# העתק ל-.env ומלא בערכים של הפרויקט שלך.
# .env נמצא ב-.gitignore ולא ייכנס ל-repo.
#
# שני הערכים האלה נמצאים ב-Supabase Dashboard → Project Settings → API.
# ה-anon key הוא מפתח ציבורי ומיועד לרוץ בדפדפן; ה-RLS הוא מה שמגן על הנתונים.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# שים לב: מפתח ה-Claude API לא נמצא כאן ולעולם לא יימצא.
# הוא יושב כסוד בצד השרת:
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
